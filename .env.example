# ── Provider API keys ────────────────────────────────────────────────
# Used directly by Agno model classes AND by LiteLLM (both read these
# standard env var names, so you only set them once).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Model routing ──
# "Primary" is used for planning / code generation (needs strong reasoning).
# "Fast" is used for cheap, high-volume steps: extraction, summarization,
# retrieval re-ranking, and the inner ReAct tool-loop chatter. Defaulted to
# the same model as PRIMARY rather than a cheap mini-model: gpt-4o-mini was
# observed to ignore "stop searching, you're at the tool-call limit" and
# loop indefinitely re-issuing near-duplicate searches (see comprehend.py's
# _run_with_timeout for the hard-cap safety net that remains regardless).
# "Verifier" should be a DIFFERENT model family than PRIMARY, so mistakes
# aren't correlated (an Anthropic model checking OpenAI's work, or vice versa)
# - keep this on OpenAI as long as PRIMARY/FAST are Anthropic.
PAPERSMITH_PRIMARY_MODEL=anthropic/claude-sonnet-4-5
PAPERSMITH_FALLBACK_MODEL=openai/gpt-4o
PAPERSMITH_FAST_MODEL=anthropic/claude-sonnet-4-5
PAPERSMITH_VERIFIER_MODEL=openai/gpt-4o

# ── Guardrails ───────────────────────────────────────────────────────
# Hard ceiling on total recorded LLM spend per run (USD).
PAPERSMITH_MAX_RUN_BUDGET_USD=2.00
# Max retries per coding milestone before escalating to human checkpoint.
PAPERSMITH_MAX_RETRIES=4
# Max times to regenerate a milestone's code after the faithfulness verifier
# rejects it (each attempt gets the verifier's specific concerns as feedback,
# and can itself use up to PAPERSMITH_MAX_RETRIES coding attempts). Each
# retry is a full code-gen + verify round trip, so raise this only if you'd
# rather wait longer for a shot at auto-resolving ambiguous milestones.
PAPERSMITH_MAX_VERIFY_RETRIES=2
# Max seconds a sandboxed code execution may run before being killed.
PAPERSMITH_EXEC_TIMEOUT_SECONDS=30
# Max seconds to wait on a single LLM call before failing it (litellm's own
# default is 6000s, effectively unbounded for an interactive run).
PAPERSMITH_LLM_TIMEOUT_SECONDS=90
# Hard wall-clock cap on the comprehension agent's whole tool-calling run.
# Guards against the model retrying tool calls past tool_call_limit forever
# (each retry succeeds quickly, so the per-call LLM timeout above never
# fires) - see the comment in agents/comprehend.py for detail.
PAPERSMITH_COMPREHEND_TIMEOUT_SECONDS=180

# ── Storage (all local, no external infra needed) ───────────────────
PAPERSMITH_SQLITE_PATH=./data/papersmith.db
PAPERSMITH_PAPERS_DIR=./data/papers
PAPERSMITH_VECTOR_DB_PATH=./data/vectorstore
PAPERSMITH_ARTIFACTS_DIR=./data/artifacts
PAPERSMITH_OUTPUT_DIR=./output

# ── Optional: LangSmith/Phoenix/other tracing, leave blank if unused ──
# LITELLM_LOG=INFO
